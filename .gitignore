# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# Sensitive WordPress exports with OAuth tokens
TRANSFER-TO-LAUNCHPAD/docs/03-reference/wordpress-exports/options.json
.env*.local

# Persona-db infrastructure (WO-2026-152)
skyradar.yaml
.venv/
src/mcp/node_modules/
.gemini-clipboard/
preflight-*.yaml

# Python virtual environment (zoom skill scaffold, OPS 2026-06-18)
venv/
.venv/

# Machine-generated preflight state (2026-08-17)
# preflight-*.yaml above only covered the dashboard; the requester marker and the
# mywork JSON are regenerated every boot and showed as untracked noise in every
# session's git status.
preflight-*.json
.preflight-requester-lastseen

# Python bytecode
__pycache__/
*.py[cod]

# Machine-generated session state — written by preflight-dashboard.sh on EVERY boot.
# Tracking these leaves every persona tree permanently dirty, which is what makes
# agency-os-pull refuse its ff-merge and silently freezes a VM on stale shared code.
.preflight-*
preflight-mywork.json
supabase/.temp/
.claude/*.bak-*
CLAUDE.md.bak-*
